# Firebase Functions Environment Variables
# Copy this file to .env for local development

# Comma-separated list of allowed CORS origins
# Example: https://autoscroll.stux.dev,http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=https://autoscroll.stux.dev,http://localhost:5173,http://localhost:3000

# Optional secret for localhost access (leave empty to allow all localhost)
# Set this to require a secret header for localhost requests
LOCALHOST_SECRET=

# Reddit username for User-Agent header
# Format: User-Agent will be "web:autoscroll.stux.dev:v1.0.0 (by /u/<username>)"
REDDIT_USERNAME=StuxieDev

# Reddit OAuth Credentials
# Get these from: https://www.reddit.com/prefs/apps
# Create a "script" type app
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
