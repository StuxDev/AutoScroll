# Firebase Functions Environment Variables
# Copy this file to .env for local development

# Comma-separated list of allowed CORS origins
# Example: https://autoscroll.stux.dev,http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=https://autoscroll.stux.dev,http://localhost:5173,http://localhost:3000

# Optional secret for localhost access (leave empty to allow all localhost)
# Set this to require a secret header for localhost requests
LOCALHOST_SECRET=

# Apify API token for the Reddit scraper actor
# Get this from: https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here
